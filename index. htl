    <!-- ================= HALAMAN LOGIN ================= -->
    <div id="login-page" class="flex-grow flex items-center justify-center p-4">
        <div class="bg-white p-8 rounded-xl shadow-lg max-w-md w-full border border-gray-200">
            <div class="text-center mb-6">
                <img src="https://iili.io/nV4nsZF.jpg" alt="Logo Perhiptani" class="h-24 mx-auto mb-3 object-contain">
                <h1 class="text-xl font-bold text-green-800">PEMILIHAN KETUA DPD PERHIPTANI</h1>
                <p class="text-sm font-semibold text-gray-600">KABUPATEN WONOSOBO</p>
            </div>

            <form id="login-form" onsubmit="return false;">
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2">Username</label>
                    <input type="text" id="login-username" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500" placeholder="Masukkan username" required>
                </div>
                <div class="mb-6">
                    <label class="block text-gray-700 text-sm font-bold mb-2">Password</label>
                    <input type="password" id="login-password" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500" placeholder="Masukkan password" required>
                </div>
                <div id="login-error" class="text-red-500 text-sm mb-4 hidden text-center font-medium"></div>

                <div class="flex flex-col gap-3">
                    <button onclick="handleLogin('voter')" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 px-4 rounded-lg shadow transition duration-200">
                        Masuk sebagai Pemilih
                    </button>
                    <button onclick="handleLogin('admin')" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-4 rounded-lg shadow transition duration-200">
                        Masuk sebagai Admin
                    </button>
                </div>
            </form>
        </div>
    </div>

