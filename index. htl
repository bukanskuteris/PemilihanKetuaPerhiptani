                    <span class="font-bold text-xl tracking-wide">e-Voting</span>
                </div>
                <div class="flex items-center gap-4">
                    <span id="voter-display-name" class="font-medium text-sm md:text-base"></span>
                    <button onclick="logout()" class="bg-red-500 hover:bg-red-600 text-white text-sm px-3 py-1.5 rounded transition">
                        <i class="fas fa-sign-out-alt mr-1"></i> Keluar
